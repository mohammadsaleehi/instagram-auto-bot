# Instagram
INSTAGRAM_BASE_URL=https://www.instagram.com

# Automatic login
# true  = fill/submit credentials when both are set and the session is unauthenticated
# false = always use manual login in the browser
AUTO_LOGIN=true
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Browser mode
# existing       = attach to your already-running Chrome window over CDP (default)
# launch         = isolated Playwright persistent profile
# launch-x11     = isolated Google Chrome window with --ozone-platform=x11
# storage-state  = optional headless server mode using a transferred Playwright storage state
BROWSER_MODE=existing
BROWSER_CDP_ENDPOINT=chrome
BROWSER_CHANNEL=chrome

# Optional isolated launch mode
# BROWSER_MODE=launch
# BROWSER_EXECUTABLE_PATH=/snap/bin/chromium
# BROWSER_PLATFORM=x11
# USER_DATA_DIR=./sessions/instagram

# Optional X11 launch mode (separate profile from CDP/generic sessions)
# BROWSER_MODE=launch-x11
# Defaults when unset:
#   BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
#   BROWSER_PLATFORM=x11
#   USER_DATA_DIR=./sessions/instagram-x11
# HEADLESS=false

# Optional server storage-state mode (does not change the default personal Chrome workflow)
# 1. Local: npm run login
# 2. Complete Instagram login/CAPTCHA/2FA manually, then press Enter
# 3. Stop the server bot, then securely copy:
#    scp data/instagram-auth.json USER@SERVER:/PATH/TO/Instagram-Auto-Bot/data/instagram-auth.json
# 4. Server:
#    chmod 700 data && chmod 600 data/instagram-auth.json
#    BROWSER_MODE=storage-state npm start
# Never transfer auth state via Telegram, GitHub, or public file-sharing services.
# BROWSER_MODE=storage-state
# HEADLESS=true
AUTH_STORAGE_STATE_PATH=./data/instagram-auth.json
AUTH_STATE_SAVE_INTERVAL_MS=300000

HEADLESS=false
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
USER_DATA_DIR=./sessions/instagram

# Timeouts (milliseconds)
LOGIN_TIMEOUT=300000
NAVIGATION_TIMEOUT=60000

# Logging: error | warn | info | debug
LOG_LEVEL=info

# Automation engine
APP_TIMEZONE=Europe/Berlin
WORKER_CONCURRENCY=1
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_MS=5000
TASK_RETRY_MAX_MS=300000
TASK_STALE_TIMEOUT_MS=60000
TASK_SHUTDOWN_TIMEOUT_MS=30000
WORKER_POLL_INTERVAL_MS=1000
SCHEDULER_POLL_INTERVAL_MS=1000
SESSION_MONITOR_INTERVAL_MS=30000
DATABASE_PATH=./data/bot.sqlite
CONTROL_SOCKET_PATH=./data/bot.sock
CONTROL_TOKEN_PATH=./data/bot.control-token

# Content management / publishing / Stories
# MEDIA_LIBRARY_DIR=./data/media
# PUBLISHING_ADAPTER=mock
# CONTENT_DRY_RUN=true
#
# Official Instagram Graph publishing (Professional account required):
# PUBLISHING_ADAPTER=instagram-graph
# CONTENT_DRY_RUN=false
# INSTAGRAM_GRAPH_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
#
# Authentication model (do not mix hosts/tokens/permissions):
# facebook  → graph.facebook.com + Page/User token
#             permissions: instagram_basic, instagram_content_publish, pages_read_engagement
# instagram → graph.instagram.com + Instagram User token
#             permissions: instagram_business_basic, instagram_business_content_publish
# INSTAGRAM_GRAPH_LOGIN_FLOW=facebook
# INSTAGRAM_GRAPH_API_VERSION=v21.0
# Optional override (defaults from login flow):
# INSTAGRAM_GRAPH_API_BASE_URL=
#
# Required for real Graph publishing (Stories included): HTTPS origin that serves MEDIA_LIBRARY_DIR
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media

# Intelligence Core / OpenRouter (single AI gateway)
# AI_PROVIDER=openrouter
# AI_PROVIDER=mock   # deterministic tests only; never treat mock output as real AI
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=                    # required for real AI ops, e.g. openai/gpt-4o-mini
# OPENROUTER_FALLBACK_MODELS=         # optional comma-separated model IDs
# OPENROUTER_APP_NAME=Instagram Automation Agent
# OPENROUTER_APP_URL=
# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_TOOL_ITERATIONS=8
# AI_MAX_RETRIES=2

# Optional captcha solver (2Captcha / CapSolver)
# Stealth alone cannot mint a valid captcha token.
# CAPTCHA_SOLVER=2captcha
# CAPTCHA_API_KEY=
# PROXY=
# CAPTCHA_TIMEOUT_MS=120000
